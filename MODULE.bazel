module(
    name = "calque",
    version = "0.0.1",
)

bazel_dep(name = "mabel", version = "0.60.1")
archive_override(
    module_name = "mabel",
    integrity = "sha256-nJs4++X+xOh1Bif3Lbmy1Tu4XnpBn6LxgnvhuWCy9jU=",
    strip_prefix = "mabel-0.60.1",
    urls = ["https://github.com/menny/mabel/releases/download/v0.60.1/mabel-0.60.1.tar.gz"],
)

bazel_dep(name = "rules_kotlin", version = "2.4.20")
bazel_dep(name = "rules_java", version = "9.9.0")
bazel_dep(name = "rules_android", version = "0.8.0")
single_version_override(
    module_name = "rules_android",
    patch_strip = 1,
    patches = ["//patches:rules_android_no_robolectric.patch"],
    version = "0.8.0",
)

bazel_dep(name = "aspect_rules_lint", version = "2.9.1")

bazel_dep(name = "buildifier_prebuilt", version = "10.1.0", dev_dependency = True)

# Android SDK
remote_android_extensions = use_extension(
    "@rules_android//bzlmod_extensions:android_extensions.bzl",
    "remote_android_tools_extensions",
)
use_repo(remote_android_extensions, "android_tools")

android_sdk_repository_extension = use_extension(
    "@rules_android//rules/android_sdk_repository:rule.bzl",
    "android_sdk_repository_extension",
)
use_repo(android_sdk_repository_extension, "androidsdk")

register_toolchains("@androidsdk//:sdk-toolchain", "@androidsdk//:all")

# Maven dependencies
mabel = use_extension("@mabel//rules:extensions.bzl", "mabel")
mabel.install(
    aliases_repo = "maven",
    lockfile = "//:maven_install.json",
)
use_repo(mabel, "maven")

# Formatting tools
format_tools = use_extension("@aspect_rules_lint//format:extensions.bzl", "tools")
format_tools.ktfmt()
use_repo(format_tools, "ktfmt")
