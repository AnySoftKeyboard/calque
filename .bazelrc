# Calque Bazel Configuration

# Output and UI
common --color=yes

# Java toolchain configuration (Java 17 for target and tool execution)
build --java_language_version=17
build --tool_java_language_version=17
build --java_runtime_version=remotejdk_17
build --tool_java_runtime_version=remotejdk_17

# Test options
test --test_output=errors

# Lint configuration
build:lint --aspects=//tools/lint:linters.bzl%detekt,//tools/lint:linters.bzl%buildifier
build:lint --output_groups=rules_lint_human
build:lint --@aspect_rules_lint//lint:fail_on_violation
