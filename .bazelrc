# Calque Bazel Configuration

# Output and UI
common --color=yes

# Test options
test --test_output=errors

# Lint configuration
build:lint --aspects=//tools/lint:linters.bzl%detekt,//tools/lint:linters.bzl%buildifier
build:lint --output_groups=rules_lint_human
build:lint --@aspect_rules_lint//lint:fail_on_violation
