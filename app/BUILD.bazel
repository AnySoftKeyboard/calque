load("@rules_android//rules:rules.bzl", "android_binary")
load("@rules_kotlin//kotlin:android.bzl", "kt_android_library", "kt_android_local_test")

package(default_visibility = ["//visibility:public"])

exports_files([
    "src/main/assets/databases/seed.db",
])

filegroup(
    name = "seed_db_asset",
    srcs = ["src/main/assets/databases/seed.db"],
)

kt_android_library(
    name = "app_lib",
    srcs = glob(["src/main/kotlin/**/*.kt"]),
    custom_package = "com.anysoftkeyboard.calque",
    kotlinc_opts = "//tools/room:room_kotlinc_options",
    manifest = "src/main/AndroidManifest.xml",
    plugins = [
        "//tools/compose:compose_compiler_plugin",
        "//tools/room:room_compiler_plugin",
    ],
    resource_files = glob(["src/main/res/**"]),
    deps = [
        "//core/data",
        "//core/linguistics",
        "//core/reader",
        "//core/toolbox",
        "@maven//androidx/activity/activity-compose",
        "@maven//androidx/compose/foundation/foundation",
        "@maven//androidx/compose/material3/material3",
        "@maven//androidx/compose/runtime/runtime",
        "@maven//androidx/compose/ui/ui",
        "@maven//androidx/compose/ui/ui-tooling-preview",
        "@maven//androidx/lifecycle/lifecycle-viewmodel-compose",
        "@maven//androidx/lifecycle/lifecycle-viewmodel-ktx",
        "@maven//androidx/room/room-common",
        "@maven//androidx/room/room-ktx",
        "@maven//androidx/room/room-runtime",
        "@maven//org/jetbrains/kotlinx/kotlinx-coroutines-core-jvm",
    ],
)

android_binary(
    name = "app",
    assets = glob(["src/main/assets/**"]),
    assets_dir = "src/main/assets",
    custom_package = "com.anysoftkeyboard.calque",
    manifest = "src/main/AndroidManifest.xml",
    manifest_values = {
        "applicationId": "com.anysoftkeyboard.calque",
        "minSdkVersion": "26",
        "targetSdkVersion": "35",
        "versionCode": "1",
        "versionName": "0.0.1",
    },
    deps = [
        ":app_lib",
    ],
)

