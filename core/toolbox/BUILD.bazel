load("@rules_kotlin//kotlin:jvm.bzl", "kt_jvm_library", "kt_jvm_test")

package(default_visibility = ["//visibility:public"])

kt_jvm_library(
    name = "toolbox",
    srcs = glob(["src/main/kotlin/**/*.kt"]),
    visibility = ["//visibility:public"],
    deps = [
        "//core/data",
        "//core/linguistics",
    ],
)

kt_jvm_test(
    name = "trap_detector_engine_test",
    size = "small",
    srcs = ["src/test/kotlin/com/anysoftkeyboard/calque/toolbox/TrapDetectorEngineTest.kt"],
    test_class = "com.anysoftkeyboard.calque.toolbox.TrapDetectorEngineTest",
    deps = [
        ":toolbox",
        "//core/data",
        "@maven//:junit_junit",
    ],
)

